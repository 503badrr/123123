# Switch | سويتش — Production environment example
# Copy these values into the deployment provider's environment settings.
# Never commit real secret keys, live product codes, or credential-bearing MCP URLs.

PUBLIC_SITE_URL=https://swwiitch.com
PUBLIC_API_URL=https://swwiitch.com/api
PUBLIC_APP_NAME=Switch
PUBLIC_APP_NAME_AR=سويتش
PUBLIC_SUPPORT_EMAIL=support@swwiitch.com
SITE_URL=https://swwiitch.com

VITE_PUBLIC_SITE_URL=https://swwiitch.com
VITE_PUBLIC_API_URL=https://swwiitch.com/api
VITE_SUPPORT_EMAIL=support@swwiitch.com

# Public Supabase values
SUPABASE_URL=https://slnjgmwckknzwjcmlolj.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://slnjgmwckknzwjcmlolj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend-only Supabase key. Never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Select the production hosted checkout provider.
PAYMENT_PROVIDER=tap

MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Tap live secrets/settings are backend-only.
# Set TAP_APPLE_PAY_ENABLED=1 only after Tap confirms Apple Pay is enabled for this merchant.
TAP_PUBLISHABLE_KEY=
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
TAP_SOURCE_ID=
TAP_STATEMENT_DESCRIPTOR=Switch
TAP_APPLE_PAY_ENABLED=0

TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_WEBHOOK_SECRET=
TELR_TEST_MODE=0
TELR_FRAMED=0
TELR_PANELS=
TELR_TRANTYPE=

HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_SECRET=
HYPERPAY_BASE_URL=https://eu-test.oppwa.com

RESEND_API_KEY=
EMAIL_FROM="Switch سويتش <orders@swwiitch.com>"
EMAIL_REPLY_TO=support@swwiitch.com

# AliExpress AE-Dropshipper. All credentials are backend-only.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_SESSION=
ALIEXPRESS_API_ENDPOINT=https://eco.taobao.com/router/rest

# Shopify Headless public build values.
# Configure these in the Cloudflare build environment for the production Worker.
VITE_SHOPIFY_STORE_DOMAIN=gxgjyr-m9.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_TOKEN=

# Shopify private runtime values. Keep as encrypted Cloudflare secrets/settings.
SHOPIFY_STORE_DOMAIN=gxgjyr-m9.myshopify.com
PRIVATE_STOREFRONT_API_TOKEN=
SHOPIFY_PRIVILEGED_PROXY_ENABLED=0

# Zid Merchant API runtime values. Keep credentials as encrypted Cloudflare
# secrets/settings. Writes stay disabled until read-only authentication is verified.
ZID_API_BASE_URL=https://api.zid.sa/v1
ZID_AUTHORIZATION_TOKEN=
ZID_MANAGER_TOKEN=
ZID_STORE_ID=
ZID_SYNC_WRITES_ENABLED=0
ZID_WEBHOOK_USERNAME=
ZID_WEBHOOK_PASSWORD=

# Developer/agent MCP value only. Do not expose to browser or commit a live URL.
ZID_MCP_URL=

OPENAI_API_KEY=
GITHUB_TOKEN=
JWT_SECRET=
SESSION_SECRET=
ADMIN_EMAIL=
