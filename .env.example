# ============================================================
# Switch | سويتش — Environment example
# Copy to .env and fill values locally or in hosting secrets.
# NEVER commit real secret keys or credential-bearing MCP URLs.
# ============================================================

# --- Public app config ---
PUBLIC_SITE_URL=https://swwiitch.com
PUBLIC_API_URL=https://swwiitch.com/api
PUBLIC_APP_NAME=Switch
PUBLIC_APP_NAME_AR=سويتش
PUBLIC_SUPPORT_EMAIL=support@swwiitch.com
SITE_URL=https://swwiitch.com

# Vite client-exposed values. These are public values only.
VITE_PUBLIC_SITE_URL=https://swwiitch.com
VITE_PUBLIC_API_URL=https://swwiitch.com/api
VITE_SUPPORT_EMAIL=support@swwiitch.com

# --- Supabase Production ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Hosted payment provider selection ---
# Hosted checkout is enabled for: moyasar | tap | telr
PAYMENT_PROVIDER=moyasar

# --- Moyasar hosted redirect ---
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# --- Tap Payments hosted redirect ---
# TAP_SECRET_KEY and merchant settings are backend-only.
# Keep TAP_APPLE_PAY_ENABLED=0 until Apple Pay is enabled for the merchant in Tap.
TAP_PUBLISHABLE_KEY=
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
TAP_SOURCE_ID=
TAP_STATEMENT_DESCRIPTOR=Switch
TAP_APPLE_PAY_ENABLED=0

# --- Telr Hosted Payment ---
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_WEBHOOK_SECRET=
TELR_TEST_MODE=1
TELR_FRAMED=0
TELR_PANELS=
TELR_TRANTYPE=

# --- HyperPay ---
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_SECRET=
HYPERPAY_BASE_URL=https://eu-test.oppwa.com

# --- Transactional email ---
RESEND_API_KEY=
EMAIL_FROM="Switch سويتش <orders@swwiitch.com>"
EMAIL_REPLY_TO=support@swwiitch.com

# --- AliExpress AE-Dropshipper (backend-only) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_SESSION=
ALIEXPRESS_API_ENDPOINT=https://eco.taobao.com/router/rest

# ============================================================
# --- Shopify Headless Integration ---
# ============================================================
# Browser/build-time public Storefront configuration.
# The Storefront token is intentionally client-visible but should still be
# managed as a deploy/build setting so it can be rotated without source edits.
VITE_SHOPIFY_STORE_DOMAIN=gxgjyr-m9.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_TOKEN=

# Server-only configuration for explicitly approved private Storefront calls.
# Keep the privileged proxy disabled unless customer-linked operations are
# deliberately enabled and PRIVATE_STOREFRONT_API_TOKEN is configured.
SHOPIFY_STORE_DOMAIN=gxgjyr-m9.myshopify.com
PRIVATE_STOREFRONT_API_TOKEN=
SHOPIFY_PRIVILEGED_PROXY_ENABLED=0

# ============================================================
# --- Zid sales channel (server-only) ---
# ============================================================
# Never prefix these with VITE_. Zid Merchant API credentials must stay in
# Cloudflare runtime secrets/settings. Keep writes disabled until a live read
# probe succeeds against the intended Zid store.
ZID_API_BASE_URL=https://api.zid.sa/v1
ZID_AUTHORIZATION_TOKEN=
ZID_MANAGER_TOKEN=
ZID_STORE_ID=
ZID_SYNC_WRITES_ENABLED=0
ZID_WEBHOOK_USERNAME=
ZID_WEBHOOK_PASSWORD=

# ============================================================
# --- Developer AI / MCP tooling ---
# ============================================================
# The Zid endpoint supplied by Zid contains credential material in its URL.
# Set it only in your local/Codespaces environment. Never prefix it with VITE_.
ZID_MCP_URL=

# --- Backend-only optional integrations ---
OPENAI_API_KEY=
GITHUB_TOKEN=
JWT_SECRET=
SESSION_SECRET=
ADMIN_EMAIL=
